#include <windows.h>
#include "resource.h"

IDI_CMCL_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,4,0,0
 PRODUCTVERSION 0,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "CMCL"
            VALUE "FileDescription", "CMCL - C++ Minecraft Launcher"
            VALUE "FileVersion", "0.5.1"
            VALUE "InternalName", "cmcl-ui"
            VALUE "OriginalFilename", "cmcl-ui.exe"
            VALUE "ProductName", "CMCL"
            VALUE "ProductVersion", "0.5.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
